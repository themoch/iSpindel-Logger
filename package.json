{
  "name": "iSpindel-Logger",
  "version": "1.0.0",
  "description": "Logger for calibration of iSpindel",
  "main": "src/server/index.js",
  "scripts": {
    "build": "webpack --mode production",
    "start": "npm run build && NODE_ENV=production node src/server/index.js",
    "client": "webpack-dev-server --mode development --devtool inline-source-map --hot",
    "server": "NODE_ENV=development nodemon src/server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "node seed-database.js"
  },
  "author": "Andrew Moch",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.6.0",
    "body-parser": "^1.20.3",
    "chart.js": "^4.5.1",
    "core-js": "^3.39.0",
    "express": "^4.21.2",
    "open": "^10.1.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@eslint/js": "^9.17.0",
    "babel-loader": "^9.2.1",
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^9.1.2",
    "css-loader": "^7.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.14.0",
    "html-webpack-plugin": "^5.6.3",
    "nodemon": "^3.1.9",
    "style-loader": "^4.0.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
